# Secrets (never commit). .env.example is the only env file tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local caches / databases (ctviz.db is rebuilt by `ctviz warm`)
*.db
*.db-wal
*.db-shm
.cache/
.ctviz_cache/
data/cache/

# Node / frontend
node_modules/
# frontend/dist/ is committed so a fresh clone serves the viewer without a Node build

# OS / editors / logs
.DS_Store
*.log
.idea/
.vscode/

# Personal notes (not shipped)
explanations.md

# Claude Code local state
.claude/settings.local.json
.claude/worktrees/

# Per-request inspection artifacts
runs/
!frontend/dist/
