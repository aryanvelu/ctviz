{"protocolSection": {"identificationModule": {"nctId": "NCT07654361", "orgStudyIdInfo": {"id": "GSBR-1290-12"}, "organization": {"fullName": "Gasherbrum Bio, Inc., a wholly owned subsidiary of Structure Therapeutics", "class": "INDUSTRY"}, "briefTitle": "Efficacy and Safety of Aleniglipron in Participants With Obesity or Overweight With a Weight-Related Comorbidity (ACCOMPLISH-1)", "officialTitle": "A Randomized, Double-Blind, Placebo-Controlled, Pivotal Phase 3 Study to Evaluate the Long-Term Efficacy and Safety of Multiple Maintenance Doses of Once Daily Oral Aleniglipron for Chronic Weight Management in Adults With Obesity or Overweight and a Weight-Related Comorbidity"}, "statusModule": {"statusVerifiedDate": "2026-06", "overallStatus": "RECRUITING", "expandedAccessInfo": {"hasExpandedAccess": false}, "startDateStruct": {"date": "2026-07-13", "type": "ACTUAL"}, "primaryCompletionDateStruct": {"date": "2028-09", "type": "ESTIMATED"}, "completionDateStruct": {"date": "2028-11", "type": "ESTIMATED"}, "studyFirstSubmitDate": "2026-06-12", "studyFirstSubmitQcDate": "2026-06-12", "studyFirstPostDateStruct": {"date": "2026-06-17", "type": "ACTUAL"}, "lastUpdateSubmitDate": "2026-08-07", "lastUpdatePostDateStruct": {"date": "2026-08-10", "type": "ACTUAL"}}, "sponsorCollaboratorsModule": {"responsibleParty": {"type": "SPONSOR"}, "leadSponsor": {"name": "Gasherbrum Bio, Inc., a wholly owned subsidiary of Structure Therapeutics", "class": "INDUSTRY"}}, "oversightModule": {"oversightHasDmc": true, "isFdaRegulatedDrug": true, "isFdaRegulatedDevice": false}, "descriptionModule": {"briefSummary": "Study GSBR-1290-12 is a Phase 3 pivotal, multicenter, global, randomized, placebo-controlled, double-blind study to investigate the long-term efficacy, safety, and tolerability of 3 maintenance doses of aleniglipron once daily (QD) compared with placebo, when used in combination with a reduced-calorie diet and increased physical activity. All participants will be randomized to at least 76 weeks of treatment to evaluate the effects on long term body weight changes, tolerability, and safety. In addition, the study will compare the effects between aleniglipron and placebo on blood pressure (BP), lipid parameters, patient-reported outcomes."}, "conditionsModule": {"conditions": ["Obesity", "Overweight", "Chronic Weight Management"], "keywords": ["Obesity", "Overweight", "GSBR-1290", "Aleniglipron", "Chronic weight management", "Obese", "Small molecule", "GLP-1", "Structure Therapeutics"]}, "designModule": {"studyType": "INTERVENTIONAL", "phases": ["PHASE3"], "designInfo": {"allocation": "RANDOMIZED", "interventionModel": "PARALLEL", "primaryPurpose": "TREATMENT", "maskingInfo": {"masking": "TRIPLE", "whoMasked": ["PARTICIPANT", "CARE_PROVIDER", "INVESTIGATOR"]}}, "enrollmentInfo": {"count": 3600, "type": "ESTIMATED"}}, "armsInterventionsModule": {"armGroups": [{"label": "aleniglipron Arm 1", "type": "EXPERIMENTAL", "description": "Participants will receive aleniglipron administered orally.", "interventionNames": ["Drug: Aleniglipron"]}, {"label": "aleniglipron Arm 2", "type": "EXPERIMENTAL", "description": "Participants will receive aleniglipron administered orally.", "interventionNames": ["Drug: Aleniglipron"]}, {"label": "aleniglipron Arm 3", "type": "EXPERIMENTAL", "description": "Participants will receive aleniglipron administered orally.", "interventionNames": ["Drug: Aleniglipron"]}, {"label": "Placebo Arm 4", "type": "EXPERIMENTAL", "description": "Participants will receive placebo administered orally.", "interventionNames": ["Drug: Placebo"]}], "interventions": [{"type": "DRUG", "name": "Aleniglipron", "description": "Drug: aleniglipron administered orally Drug", "armGroupLabels": ["aleniglipron Arm 1", "aleniglipron Arm 2", "aleniglipron Arm 3"]}, {"type": "DRUG", "name": "Placebo", "description": "Drug: placebo administered orally", "armGroupLabels": ["Placebo Arm 4"]}]}, "outcomesModule": {"primaryOutcomes": [{"measure": "Percent change in body weight from Baseline", "timeFrame": "Baseline and Week 76"}], "secondaryOutcomes": [{"measure": "Change in body weight (absolute) from Baseline", "timeFrame": "Baseline and week 76"}, {"measure": "Percentage of participants who achieve \u22655% reduction in body weight", "timeFrame": "Baseline and week 76"}, {"measure": "Percentage of participants who achieve \u226510% reduction in body weight", "timeFrame": "Baseline and week 76"}, {"measure": "Percentage of participants who achieve \u226515% reduction in body weight", "timeFrame": "Baseline and week 76"}, {"measure": "Percentage of participants who achieve \u226520% reduction in body weight", "timeFrame": "Baseline and week 76"}, {"measure": "Change in waist circumference from Baseline", "timeFrame": "Baseline and week 76"}, {"measure": "Change in resting systolic blood pressure from Baseline", "timeFrame": "Baseline and week 76"}, {"measure": "Percent change in fasting triglycerides and non-HDL cholesterol from Baseline", "timeFrame": "Baseline and week 76"}, {"measure": "Change in Impact of Weight on Quality of Life-Lite Clinical Trials Version physical function from Baseline", "timeFrame": "Baseline and week 76"}, {"measure": "Change in HbA1c from Baseline", "timeFrame": "Baseline and week 76"}, {"measure": "Change in body mass index from Baseline", "timeFrame": "Baseline and week 76"}, {"measure": "Percent change in fasting total cholesterol from Baseline", "timeFrame": "Baseline and week 76"}, {"measure": "Change in fasting glucose from Baseline", "timeFrame": "Baseline and week 76"}, {"measure": "Change in resting diastolic blood pressure from Baseline", "timeFrame": "Baseline and week 76"}], "otherOutcomes": [{"measure": "Percentage of participants who achieve \u226525% reduction in body weight", "timeFrame": "Baseline and week 76"}]}, "eligibilityModule": {"eligibilityCriteria": "Inclusion Criteria:\n\n* Signed informed consent\n* BMI \u226530 kg/m2 (obese) or BMI \u226527 kg/m2 (overweight) and presence of \u22651 of the obesity related comorbidities.\n\nExclusion Criteria:\n\n* Previously documented diagnosis of type 1 diabetes, type 2 diabetes, or any other type of diabetes.\n* Self-reported change in body weight \\>5 kg within 3 months before Screening.\n* Have prior or planned surgical or non-surgical treatment for obesity.\n* Have or plan to have endoscopic and/or device-based therapy for obesity.\n* Have obesity induced by other endocrine disorders.\n* Impaired renal function at Screening\n* Chronic malabsorption", "healthyVolunteers": false, "sex": "ALL", "genderBased": true, "minimumAge": "18 Years", "maximumAge": "79 Years", "stdAges": ["ADULT", "OLDER_ADULT"]}, "contactsLocationsModule": {"centralContacts": [{"name": "Medical Director", "role": "CONTACT", "phone": "1-650-457-1959", "email": "GSBRClinicalTrials@structuretx.com"}], "locations": [{"facility": "ACCOMPLISH-1 Research Site", "status": "NOT_YET_RECRUITING", "city": "Birmingham", "state": "Alabama", "zip": "35242", "country": "United States", "contacts": [{"name": "Medical Director", "role": "CONTACT", "email": "GSBRClinicalTrials@structuretx.com"}], "geoPoint": {"lat": 33.52066, "lon": -86.80249}}, {"facility": "ACCOMPLISH-1 Research Site", "status": "NOT_YET_RECRUITING", "city": "Birmingham", "state": "Alabama", "zip": "35294-3360", "country": "United States", "contacts": [{"name": "Medical Director", "role": "CONTACT", "email": "GSBRClinicalTrials@structuretx.com"}], "geoPoint": {"lat": 33.52066, "lon": -86.80249}}, {"facility": "ACCOMPLISH-1 Research Site", "status": "NOT_YET_RECRUITING", "city": "Phoenix", "state": "Arizona", "zip": "85225", "country": "United States", "contacts": [{"name": "Medical Director", "role": "CONTACT", "email": "GSBRClinicalTrials@structuretx.com"}], "geoPoint": {"lat": 33.44838, "lon": -112.07404}}, {"facility": "ACCOMPLISH-1 Research Site", "status": "NOT_YET_RECRUITING", "city": "Sun City West", "state": "Arizona", "zip": "85375", "country": "United State