# Copy to .env and fill in. Never commit .env.
# Required unless CTVIZ_OFFLINE=1
OPENAI_API_KEY=sk-your-key-here

# Run without network/LLM using recorded fixtures (0 or 1)
CTVIZ_OFFLINE=0

# Model routing (must be models your key can access)
CTVIZ_MODEL_PLANNER=gpt-5.4-nano
CTVIZ_MODEL_SYNTHESIS=gpt-5.4-nano
CTVIZ_MODEL_EXTRACT=gpt-5.4-nano
CTVIZ_MODEL_ANALYSIS=gpt-5.4-mini
CTVIZ_MODEL_ESCALATION=gpt-5.4-mini
CTVIZ_MODEL_MAX=gpt-5.4
CTVIZ_EMBEDDINGS_ENABLED=0
CTVIZ_EMBED_MODEL=text-embedding-3-small

# Storage
CTVIZ_DB_PATH=./ctviz.db

# ClinicalTrials.gov outbound limits
CTVIZ_CTGOV_BASE=https://clinicaltrials.gov/api/v2
CTVIZ_CTGOV_RPM=30
CTVIZ_CTGOV_BURST=20
CTVIZ_CTGOV_CONCURRENCY=8
CTVIZ_MAX_STUDIES=25000

# Inbound rate limiting
CTVIZ_INBOUND_RPM=30
CTVIZ_INBOUND_BURST=10

# Request budgets
CTVIZ_REQUEST_DEADLINE_S=60
CTVIZ_REQUEST_COST_CAP_USD=0.05
CTVIZ_MAX_LLM_CALLS=4

# Logging
CTVIZ_LOG_LEVEL=INFO
